PORT=5000
NODE_ENV=development
MONGO_URI=your_mongodb_atlas_connection_string

# Required. Must be at least 32 characters; use a cryptographically random value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace_me_with_a_long_random_string_at_least_32_chars

# Optional — defaults shown
JWT_ACCESS_TTL_SECONDS=900           # 15 minutes
JWT_REFRESH_TTL_SECONDS=2592000      # 30 days
BCRYPT_SALT_ROUNDS=10

# Razorpay (optional — checkout endpoint returns 503 if not set)
# Get test creds from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret — configure in Razorpay dashboard, then set the same value here
RAZORPAY_WEBHOOK_SECRET=

# Redis / BullMQ (optional — workers disabled and webhook falls back to inline
# processing if REDIS_URL is unset). Local dev: docker run -p 6379:6379 redis:7
REDIS_URL=
# Set to "false" if this process is an API-only node (a separate worker process
# will consume the queues). Default true.
ENABLE_WORKERS=true
# Default monthly maintenance amount used by the recurring bill-generator.
MONTHLY_MAINTENANCE_AMOUNT=5000

# Real-time / Socket.IO. The Socket.IO server attaches to the same HTTP server
# automatically. When REDIS_URL is set, the @socket.io/redis-adapter is wired
# up so multiple Node processes can broadcast across each other, and a Redis
# Stream-backed replay buffer fills in events the client missed while offline.

# Cache layer auto-picks Redis when REDIS_URL is set, else in-memory.
# Pino structured logging is always on; LOG_LEVEL tunes verbosity.
LOG_LEVEL=info

# Sentry (optional). When set, errors thrown out of express handlers are
# reported. Leave blank to disable.
SENTRY_DSN=

# OpenTelemetry traces (optional). When OTEL_EXPORTER_OTLP_ENDPOINT is set,
# the OTel SDK is initialised and the HTTP+Express instrumentations emit spans.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=habitat-backend
